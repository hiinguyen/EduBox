# Postgres container (docker-compose.yml). Local development only.
POSTGRES_USER=edubox
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=edubox

# App database. Keep user, password and db name in sync with the values above.
DATABASE_URL="postgresql://edubox:change-me-local-only@localhost:5432/edubox"

# Auth.js. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"

# AI tutor (names only; set real values in .env, never commit them)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
AI_MODEL=
SEED_DEMO_PASSWORD=
# Required for `pnpm db:seed`; it additionally refuses any non-local DATABASE_URL host.
# Never set this outside local development.
ALLOW_DEMO_SEED=1

# Number of reverse proxies in front of the app that append to x-forwarded-for.
# 0 (default) ignores forwarding headers, so sign-in is limited per email and globally only.
# Set to N behind N trusted proxies; the client IP is then the N-th entry from the right.
TRUSTED_PROXY_HOPS=0
